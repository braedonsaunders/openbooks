{
  "name": "openbooks",
  "version": "0.1.0-alpha.4",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "schema",
    "engine",
    "web",
    "packages/*"
  ],
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "^1.62.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "next": "16.3.0",
    "typescript": "6.0.3",
    "typescript-eslint-typescript": "npm:typescript@6.0.3"
  },
  "dependencies": {
    "cron-parser": "^5.6.2"
  },
  "overrides": {
    "@ai-sdk/gateway": "3.0.150",
    "@ai-sdk/provider-utils": "4.0.39",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.4"
    },
    "next": {
      ".": "16.3.0",
      "postcss": "8.5.26",
      "sharp": "0.35.0",
      "nanoid": "3.3.18"
    },
    "hono": "4.12.34"
  },
  "scripts": {
    "worker": "tsx engine/src/worker/index.ts",
    "lint": "node --import ./scripts/eslint-typescript-api.mjs ./node_modules/eslint/bin/eslint.js . --max-warnings=744",
    "typecheck:e2e": "tsc --project e2e/tsconfig.json",
    "check:dependencies": "npm audit --omit=dev --audit-level=moderate",
    "check:history-hygiene": "node scripts/check-history-hygiene.mjs",
    "check:repository-artifacts": "node scripts/check-repository-artifacts.mjs",
    "check:product-neutrality": "node scripts/check-product-neutrality.mjs",
    "check:credential-fetch-redirects": "node scripts/check-credential-fetch-redirects.mjs",
    "check:register-reachability": "node scripts/check-register-reachability.mjs",
    "check:container-security": "node scripts/check-container-security.mjs",
    "check:explicit-any": "node scripts/check-explicit-any.mjs",
    "test:load-harness": "node --test scripts/load-smoke.test.mjs",
    "test:history-rewrite": "node --test scripts/history-rewrite/history-rewrite.test.mjs",
    "test:load": "node scripts/load-smoke.mjs",
    "test": "npm run check:product-neutrality && npm run check:credential-fetch-redirects && NODE_ENV=test OPENBOOKS_DATA_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f OPENBOOKS_TRUSTED_TEST_BYPASS=1 node --import tsx --import ./engine/src/test-database-bypass.ts --test --test-concurrency=1 --test-force-exit 'scripts/check-repository-artifacts.test.mjs' 'scripts/deploy-edge-workflow.test.mjs' 'scripts/ci-pipeline-integrity.test.mjs' 'engine/src/**/*.test.ts' 'packages/**/*.test.ts' 'web/**/*.test.ts' 'schema/**/*.test.ts'",
    "verify:release": "npm run check:repository-artifacts && npm run check:dependencies && npm run check:container-security && npm run check:explicit-any && npm run lint && npm run typecheck:e2e && npm run typecheck --workspaces --if-present && npm test && npm -w web run build"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "cpu-features@0.0.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "msgpackr-extract@3.0.4": true,
    "@swc/core@1.15.43": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true
  }
}
