{
  "name": "openbooks",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "schema",
    "engine",
    "web",
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cron-parser": "^5.6.2"
  },
  "overrides": {
    "@ai-sdk/gateway": "3.0.150",
    "@ai-sdk/provider-utils": "4.0.39",
    "@esbuild-kit/core-utils@3.3.2": {
      "esbuild": "0.25.12"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.17"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.3"
    },
    "next@16.2.11": {
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  },
  "scripts": {
    "worker": "tsx engine/src/worker/index.ts",
    "check:product-neutrality": "node scripts/check-product-neutrality.mjs",
    "test": "npm run check:product-neutrality && node --import tsx --test --test-force-exit 'engine/src/**/*.test.ts' 'packages/**/*.test.ts' 'web/lib/**/*.test.ts' 'schema/**/*.test.ts'",
    "verify:release": "npm run typecheck --workspaces --if-present && npm test && npm -w web run build"
  }
}
