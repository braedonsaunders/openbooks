# compose-up.sh creates .env.compose with cryptographically random credentials.
# This template is for operators who prefer to manage the file themselves.
OPENBOOKS_IMAGE_TAG=latest
OPENBOOKS_PORT=4780
OPENBOOKS_APP_URL=http://localhost:4780

POSTGRES_OWNER_PASSWORD=replace-with-random-hex
OPENBOOKS_DB_PASSWORD=replace-with-a-different-random-hex
REDIS_PASSWORD=replace-with-random-hex
MINIO_ROOT_USER=openbooks
MINIO_ROOT_PASSWORD=replace-with-random-hex
SESSION_SECRET=replace-with-random-hex
OPENBOOKS_DATA_KEY=replace-me
OPENBOOKS_INTERNAL_TOKEN=replace-with-random-hex

ORG_NAME=OpenBooks
ORG_CURRENCY=replace-with-iso-4217-code
ORG_COUNTRY=replace-with-iso-3166-alpha-2
ADMIN_EMAIL=admin@openbooks.local
ADMIN_NAME=Administrator
ADMIN_PASSWORD=replace-with-a-long-random-password
