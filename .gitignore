.env.netsuite
extraction/netsuite-sdf/project.json
.env
node_modules/
gl-dump/
web/.env.local

web/.next/
.next/

# large NetSuite extraction data dumps (regenerate via extraction/dump_*.py)
extraction/transactions/
extraction/transactions_dump.log
extraction/reconciliation-report.json

# raw NetSuite XML metadata extractions — vendor SDF objects + SuiteTalk
# schema (regenerable reference, not source; kept local, out of the repo)
extraction/netsuite-sdf/
extraction/standard-schema/
extraction/**/*.xml
extraction/**/*.xsd
extraction/**/*.wsdl

engine/*.log

# local runtime artifacts
dump.rdb
.sftp-data/
.backups/

# regenerable 41MB NetSuite time-entry dump (dump_timebill.py recreates it)
extraction/account-data/timebill.ndjson

# Python bytecode cache
__pycache__/
*.pyc

# local-only workflow replication reference (names, emails, approval chains —
# never commit; the replicated flows live in the database)
docs/netsuite-workflows-*.md

# generated report/pdf output
output/

# scratch/test artifacts
tmp/
engine/harness-checkpoints/
.playwright-cli/
