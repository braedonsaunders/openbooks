# Local development. Copy to .env and replace every value before use.
# Runtime web/worker connection. This role must be NOSUPERUSER, NOBYPASSRLS,
# NOCREATEROLE, and NOCREATEDB; Compose provisions it automatically.
OPENBOOKS_DB_URL=postgres://openbooks_app:replace-me@localhost:5432/openbooks
# Bootstrap only. `OPENBOOKS_BOOTSTRAP=1 npx tsx scripts/bootstrap.ts` selects
# this owner connection without exposing it to the development web process.
OPENBOOKS_MIGRATION_DB_URL=postgres://openbooks_owner:replace-differently@localhost:5432/openbooks
OPENBOOKS_RUNTIME_DB_URL=postgres://openbooks_app:replace-me@localhost:5432/openbooks
OPENBOOKS_REDIS_URL=redis://:replace-me@localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-bytes
OPENBOOKS_DATA_KEY=replace-me
OPENBOOKS_INTERNAL_TOKEN=replace-with-at-least-32-random-bytes
OPENBOOKS_APP_URL=http://localhost:4780

# Set only when OpenBooks is behind a reverse proxy that removes client-supplied
# forwarding headers and writes its own X-Forwarded-For/X-Real-IP values. This
# enables per-network login limiting in addition to the always-on account limit.
OPENBOOKS_TRUST_PROXY=0

# Optional generic OpenID Connect SSO. The provider callback/redirect URI is
# ${OPENBOOKS_APP_URL}/api/auth/oidc/callback. SSO links only an existing active
# OpenBooks user whose provider email_verified claim is true; it never creates
# users automatically. The client secret may be omitted for a public PKCE client.
# OPENBOOKS_OIDC_ISSUER=https://id.example.com
# OPENBOOKS_OIDC_CLIENT_ID=openbooks
# OPENBOOKS_OIDC_CLIENT_SECRET=
# OPENBOOKS_OIDC_LABEL=Sign in with your organization

ORG_NAME=OpenBooks
ORG_CURRENCY=replace-with-iso-4217-code
ORG_COUNTRY=replace-with-iso-3166-alpha-2
ADMIN_EMAIL=admin@openbooks.local
ADMIN_NAME=Administrator
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional S3-compatible object storage. If all four values are omitted,
# file-cabinet data is stored in PostgreSQL.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=openbooks
# S3_SECRET_ACCESS_KEY=replace-me
# S3_BUCKET=openbooks

# Optional AI provider credentials. AI features remain unavailable when unset.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
