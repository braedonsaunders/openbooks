# Local development. Copy to .env and replace every value before use.
OPENBOOKS_DB_URL=postgres://openbooks:replace-me@localhost:5432/openbooks
OPENBOOKS_REDIS_URL=redis://:replace-me@localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-bytes
OPENBOOKS_DATA_KEY=replace-me
OPENBOOKS_INTERNAL_TOKEN=replace-with-at-least-32-random-bytes
OPENBOOKS_APP_URL=http://localhost:4780

ORG_NAME=OpenBooks
ORG_CURRENCY=CAD
ORG_COUNTRY=CA
ADMIN_EMAIL=admin@openbooks.local
ADMIN_NAME=Administrator
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional S3-compatible object storage. If all four values are omitted,
# file-cabinet data is stored in PostgreSQL.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=openbooks
# S3_SECRET_ACCESS_KEY=replace-me
# S3_BUCKET=openbooks

# Optional AI provider credentials. AI features remain unavailable when unset.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
